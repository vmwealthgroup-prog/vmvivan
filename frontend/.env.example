# Google OAuth web client credentials (server-only; never use VITE_ prefixes).
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://your-vmvira-domain.example
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Register these authorized redirect URIs in the Google Cloud OAuth client:
# http://localhost:8080/api/auth/callback/google
# http://127.0.0.1:8080/api/auth/callback/google
# https://your-vmvira-domain.example/api/auth/callback/google

# Server-only administrator allowlist; comma-separated exact sign-in emails.
VMVIRA_ADMIN_EMAILS=admin@example.com

# Persistent PostgreSQL (Neon or compatible) is required for production data.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Customer-care AI (server-only; never use VITE_ prefixes for these secrets).
# Ollama local default; for a public website use a hosted OpenAI-compatible provider.
CUSTOMER_AI_PROVIDER=ollama
CUSTOMER_AI_BASE_URL=http://127.0.0.1:11434/v1
CUSTOMER_AI_API_KEY=ollama
CUSTOMER_AI_MODEL=qwen2.5:7b
# Example hosted options:
# Groq:       CUSTOMER_AI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: CUSTOMER_AI_BASE_URL=https://openrouter.ai/api/v1
# Gemini:     CUSTOMER_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
